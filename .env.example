# ============================================================
# Discord Bot Hosting Controller — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
ADMIN_USER_ID=941139424580890666

# --- PostgreSQL ---
DATABASE_URL=postgresql://controller:securepassword@localhost:5432/bot_hosting

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Encryption ---
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=your_32_byte_base64_encoded_key_here

# --- Paths ---
# Windows: C:\bots
# Linux:   /srv/bots
BASE_BOT_PATH=C:\bots

# --- Docker ---
# Windows: npipe:////./pipe/docker_engine
# Linux:   unix:///var/run/docker.sock
DOCKER_HOST=npipe:////./pipe/docker_engine

# --- Resource Limits ---
MAX_BOTS_PER_USER=3
BOT_RAM_LIMIT_MB=512
BOT_CPU_LIMIT=0.5
BOT_DISK_LIMIT_MB=1024
MAX_USER_RAM_MB=1024
MAX_ZIP_SIZE_MB=50
DOCKER_BUILD_TIMEOUT=60

# --- Rate Limiting ---
RATE_LIMIT_COMMANDS=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=controller.log
