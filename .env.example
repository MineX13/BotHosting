# ============================================================
# MineNodes Bot Hoster — Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
ADMIN_USER_ID=941139424580890666

# --- Discord OAuth2 (for Web Panel) ---
# Get these from https://discord.com/developers/applications → OAuth2
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret

# --- Web Panel ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PANEL_SECRET_KEY=your_random_secret_key_here
PANEL_PORT=8080

# --- PostgreSQL ---
DATABASE_URL=postgresql://controller:securepassword@localhost:5432/bot_hosting

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Encryption ---
# Generate with: python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=your_32_byte_base64_encoded_key_here

# --- Paths ---
# Windows: C:\bots
# Linux:   /srv/bots
BASE_BOT_PATH=/srv/bots

# --- Resource Limits ---
MAX_BOTS_PER_USER=3
BOT_RAM_LIMIT_MB=4096
BOT_CPU_LIMIT=1.0
BOT_DISK_LIMIT_MB=5120
MAX_USER_RAM_MB=4096
MAX_ZIP_SIZE_MB=50

# --- Rate Limiting ---
RATE_LIMIT_COMMANDS=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=controller.log
