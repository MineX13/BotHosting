# ============================================================
# MineNodes Bot Hoster — Environment Configuration
# ============================================================

# --- Discord ---
DISCORD_BOT_TOKEN=your_bot_token_here
ADMIN_USER_ID=123456789012345678

# --- Discord OAuth2 (Web Panel) ---
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# --- Web Panel ---
PANEL_SECRET_KEY=change-me-to-a-random-secret
PANEL_PORT=8080

# --- PostgreSQL ---
DATABASE_URL=postgresql://user:password@localhost:5432/bot_hosting

# --- Redis (optional — rate limiting disabled if unavailable) ---
REDIS_URL=redis://localhost:6379/0

# --- Encryption ---
# Generate with: python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=generate_a_random_32_byte_base64_string_here=

# --- Paths ---
# Linux VPS:
BASE_BOT_PATH=/srv/bots

# --- Resource Limits (defaults, admins can override per-user) ---
MAX_BOTS_PER_USER=2
BOT_RAM_LIMIT_MB=512
BOT_CPU_LIMIT=0.5
BOT_DISK_LIMIT_MB=1024
MAX_USER_RAM_MB=1024
MAX_ZIP_SIZE_MB=50

# --- Rate Limiting ---
RATE_LIMIT_COMMANDS=5
RATE_LIMIT_WINDOW_SECONDS=60

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=controller.log
